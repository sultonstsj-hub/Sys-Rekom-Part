        // SEARCH & FILTER HANDLERS
        function handleSearchFilterChange() {
            APP_STATE.currentPage = 1;
            applyFiltersAndSort();
        }

        function setPresetFilter(preset) {
            APP_STATE.activePreset = preset;
            APP_STATE.currentPage = 1;

            // Highlight preset buttons
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.className = "preset-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-100";
            });
            const activeBtn = document.getElementById(`preset${preset}`);
            if (activeBtn) {
                activeBtn.className = "preset-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-yamaha-blue text-white shadow";
            }

            applyFiltersAndSort();
        }

        function sortByField(field) {
            if (APP_STATE.sortField === field) {
                APP_STATE.sortDirection = APP_STATE.sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                APP_STATE.sortField = field;
                APP_STATE.sortDirection = 'desc';
            }
            applyFiltersAndSort();
        }

        function applyFiltersAndSort() {
            let list = [...APP_STATE.processedData];

            // Search query
            const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
            if (searchVal) {
                list = list.filter(item => 
                    item.partCode.toLowerCase().includes(searchVal) || 
                    item.partName.toLowerCase().includes(searchVal)
                );
            }

            // ABC Filter
            const abcVal = document.getElementById('filterABC').value;
            if (abcVal !== 'ALL') {
                list = list.filter(item => item.abcCategory === abcVal);
            }

            // Preset Filter
            if (APP_STATE.activePreset === 'ORDER') {
                list = list.filter(item => item.recOrder > 0);
            } else if (APP_STATE.activePreset === 'STOCK0') {
                list = list.filter(item => item.stockQty === 0);
            } else if (APP_STATE.activePreset === 'SAFE') {
                list = list.filter(item => item.recOrder === 0);
            }

            // Sort Logic: Default priority order -> Rekomendasi > 0 on top, then Average Demand desc
            list.sort((a, b) => {
                // If custom field click, respect that field
                if (APP_STATE.sortField) {
                    let valA = a[APP_STATE.sortField];
                    let valB = b[APP_STATE.sortField];
                    if (typeof valA === 'string') valA = valA.toLowerCase();
                    if (typeof valB === 'string') valB = valB.toLowerCase();

                    if (valA < valB) return APP_STATE.sortDirection === 'asc' ? -1 : 1;
                    if (valA > valB) return APP_STATE.sortDirection === 'asc' ? 1 : -1;
                    return 0;
                }

                // Default Sort Rules
                if (a.recOrder > 0 && b.recOrder === 0) return -1;
                if (a.recOrder === 0 && b.recOrder > 0) return 1;
                if (b.avgDemand !== a.avgDemand) return b.avgDemand - a.avgDemand;
                return a.partCode.localeCompare(b.partCode);
            });

            APP_STATE.filteredData = list;
            renderTable();
        }

        // RENDER RECOMMENDATION TABLE
        function renderTable() {
            const tbody = document.getElementById('recommendationTableBody');
            tbody.innerHTML = '';

            const list = APP_STATE.filteredData;
            const total = list.length;

            if (total === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="13" class="text-center py-8 text-slate-400">
                            <i class="fa-solid fa-box-open text-3xl mb-2 block"></i>
                            Tidak ada data spare part yang cocok dengan filter pencarian.
                        </td>
                    </tr>
                `;
                renderPagination(0, 0, 0);
                return;
            }

            // Pagination slice
            const perPage = APP_STATE.itemsPerPage;
            const startIdx = (APP_STATE.currentPage - 1) * perPage;
            const endIdx = Math.min(startIdx + perPage, total);
            const pageData = list.slice(startIdx, endIdx);

            pageData.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 border-b border-slate-100 transition cursor-pointer";
                tr.onclick = () => openAuditModal(item.partCode);

                // Row Highlights based on status
                let rowBgClass = "";
                if (item.recOrder > 0 && item.stockQty === 0) {
                    rowBgClass = "bg-red-50/40 hover:bg-red-50";
                } else if (item.recOrder > 0) {
                    rowBgClass = "bg-amber-50/40 hover:bg-amber-50";
                }
                if (rowBgClass) tr.className += " " + rowBgClass;

                // Status Badge
                let statusBadge = "";
                if (item.status === 'STOK 0') {
                    statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-red-100 text-red-700 border border-red-300 inline-block"><i class="fa-solid fa-triangle-exclamation mr-1"></i>STOK 0</span>`;
                } else if (item.status === 'REKOMENDASI ORDER') {
                    statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-800 border border-amber-300 inline-block"><i class="fa-solid fa-cart-shopping mr-1"></i>ORDER</span>`;
                } else {
                    statusBadge = `<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-700 border border-emerald-300 inline-block"><i class="fa-solid fa-check mr-1"></i>AMAN</span>`;
                }

                // ABC Category Badge
                let abcBadgeClass = "bg-slate-100 text-slate-700";
                if (item.abcCategory === 'A') abcBadgeClass = "bg-blue-100 text-blue-800 font-bold border border-blue-200";
                else if (item.abcCategory === 'B') abcBadgeClass = "bg-teal-100 text-teal-800 font-bold border border-teal-200";

                tr.innerHTML = `
                    <td class="py-2.5 px-3 font-mono font-bold text-slate-900">${item.partCode}</td>
                    <td class="py-2.5 px-3 font-medium text-slate-700 max-w-xs truncate" title="${item.partName}">${item.partName}</td>
                    <td class="py-2.5 px-2 text-center">
                        <span class="px-1.5 py-0.5 rounded text-[10px] ${abcBadgeClass}">${item.abcCategory}</span>
                    </td>

                    <!-- Optional Detail Columns -->
                    <td class="detail-col hidden py-2.5 px-2 text-right font-mono">${item.m0Qty.toLocaleString('id-ID')}</td>
                    <td class="detail-col hidden py-2.5 px-2 text-right font-mono">${item.m1Qty.toLocaleString('id-ID')}</td>
                    <td class="detail-col hidden py-2.5 px-2 text-right font-mono">${item.m2Qty.toLocaleString('id-ID')}</td>
                    <td class="detail-col hidden py-2.5 px-2 text-right font-mono font-bold">${item.totalSales3M.toLocaleString('id-ID')}</td>

                    <td class="py-2.5 px-2 text-right font-mono font-bold text-blue-700">${item.avgDemand.toFixed(2)}</td>
                    <td class="py-2.5 px-2 text-right font-mono font-bold ${item.stockQty === 0 ? 'text-red-600' : 'text-slate-800'}">${item.stockQty.toLocaleString('id-ID')}</td>
                    <td class="py-2.5 px-2 text-center font-mono text-slate-600">${item.roq}</td>

                    <!-- Kekurangan Column -->
                    <td class="detail-col hidden py-2.5 px-2 text-right font-mono font-bold ${item.kekurangan > 0 ? 'text-amber-600' : 'text-slate-400'}">
                        ${item.kekurangan.toFixed(2)}
                    </td>

                    <td class="py-2.5 px-3 text-right font-mono font-black text-sm ${item.recOrder > 0 ? 'text-emerald-700 bg-emerald-100/60 rounded' : 'text-slate-400'}">
                        ${item.recOrder.toLocaleString('id-ID')}
                    </td>
                    <td class="py-2.5 px-3 text-center">${statusBadge}</td>
                `;

                tbody.appendChild(tr);
            });

            // Maintain detail visibility toggle state
            updateDetailColumnsVisibility();
            renderPagination(startIdx + 1, endIdx, total);
        }

        function renderPagination(start, end, total) {
            const info = document.getElementById('paginationInfo');
            info.innerText = `Menampilkan ${start} - ${end} dari ${total.toLocaleString('id-ID')} data`;

            const controls = document.getElementById('paginationControls');
            controls.innerHTML = '';

            const totalPages = Math.ceil(total / APP_STATE.itemsPerPage);
            if (totalPages <= 1) return;

            // Previous Button
            const prevBtn = document.createElement('button');
            prevBtn.className = "px-2.5 py-1 rounded border border-slate-300 text-xs bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed";
            prevBtn.disabled = APP_STATE.currentPage === 1;
            prevBtn.onclick = () => { APP_STATE.currentPage--; renderTable(); };
            prevBtn.innerHTML = `<i class="fa-solid fa-chevron-left"></i>`;
            controls.appendChild(prevBtn);

            // Page Indicator
            const pageNum = document.createElement('span');
            pageNum.className = "px-3 py-1 text-xs font-bold text-slate-700";
            pageNum.innerText = `${APP_STATE.currentPage} / ${totalPages}`;
            controls.appendChild(pageNum);

            // Next Button
            const nextBtn = document.createElement('button');
            nextBtn.className = "px-2.5 py-1 rounded border border-slate-300 text-xs bg-white hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed";
            nextBtn.disabled = APP_STATE.currentPage === totalPages;
            nextBtn.onclick = () => { APP_STATE.currentPage++; renderTable(); };
            nextBtn.innerHTML = `<i class="fa-solid fa-chevron-right"></i>`;
            controls.appendChild(nextBtn);
        }

        function changeItemsPerPage(val) {
            APP_STATE.itemsPerPage = parseInt(val, 10);
