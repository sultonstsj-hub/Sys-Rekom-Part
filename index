<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoulTown SPARE PART INVENTORY - Rekomendasi Order Sparepart</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        yamaha: {
                            blue: '#003399',
                            darkblue: '#002266',
                            lightblue: '#0055ff',
                            red: '#cc0000',
                            dark: '#0f172a'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SheetJS CDN for Excel Processing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @keyframes pulse-light {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        .animate-pulse-slow {
            animation: pulse-light 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
</head>
<body class="h-full font-sans text-slate-800 antialiased bg-slate-100 flex flex-col min-h-screen">

    <!-- LOGIN SCREEN MODAL -->
    <div id="loginModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/80 backdrop-blur-sm transition-opacity">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-md p-8 transform transition-all">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-yamaha-blue text-white mb-3 shadow-lg shadow-blue-500/30">
                    <i class="fa-solid font-bold text-2xl">Y</i>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">SYS REKOM PART</h2>
                <p class="text-xs font-semibold text-yamaha-blue tracking-widest uppercase mt-1">by SeoulTown @2026</p>
            </div>

            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Username</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-user"></i>
                        </span>
                        <input type="text" id="loginUsername" required class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-yamaha-blue focus:border-transparent text-sm" placeholder="Masukkan username">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input type="password" id="loginPassword" required class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-yamaha-blue focus:border-transparent text-sm" placeholder="Masukkan password">
                    </div>
                </div>

                <div id="loginError" class="hidden text-xs text-red-600 bg-red-50 p-2.5 rounded-lg border border-red-200 font-medium text-center">
                    Username atau password salah!
                </div>

                <button type="submit" class="w-full py-3 bg-yamaha-blue hover:bg-yamaha-darkblue text-white font-bold rounded-lg shadow-md hover:shadow-lg transition duration-200 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Masuk System</span>
                </button>
            </form>

            <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-500 space-y-1">
                <p class="font-semibold text-slate-700">Akun Akses Default:</p>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Bengkel: <code class="bg-slate-100 px-1 py-0.5 rounded border border-slate-200">yamaha</code> / <code class="bg-slate-100 px-1 py-0.5 rounded border border-slate-200">123456</code></span>
                </div>                
            </div>
        </div>
    </div>

    <!-- APP HEADER -->
    <header class="bg-yamaha-dark text-white shadow-xl border-b-4 border-yamaha-blue sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-yamaha-blue flex items-center justify-center shadow-inner font-extrabold text-white text-xl">
                    Y
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-black tracking-tight text-white flex items-center gap-2">
                        SEOULTOWN SPARE PART INVENTORY
                    </h1>
                    <p class="text-xs text-blue-300 font-medium">Demand Analysis & Order Recommendation System</p>
                </div>
            </div>

            <div class="flex items-center justify-between md:justify-end gap-3 border-t md:border-t-0 pt-2 md:pt-0 border-slate-700">
                <div id="userInfoContainer" class="flex items-center gap-2 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700">
                    <i class="fa-solid fa-circle-user text-blue-400"></i>
                    <div class="text-xs">
                        <span id="userNameDisplay" class="font-bold text-white block">Guest</span>
                        <span id="userRoleBadge" class="text-[10px] text-blue-300 font-semibold uppercase">Bengkel</span>
                    </div>
                </div>

                <button id="btnAdminMenu" onclick="openAdminModal()" class="hidden px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1.5 shadow">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Admin ROQ</span>
                </button>

                <button onclick="handleLogout()" class="px-3 py-1.5 bg-red-600/80 hover:bg-red-600 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1.5">
                    <i class="fa-solid fa-power-off"></i>
                    <span>Keluar</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- UPLOAD SECTION -->
        <section class="bg-white rounded-xl shadow-md border border-slate-200 p-5">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-100">
                <div>
                    <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-file-excel text-emerald-600"></i>
                        Upload Source Data Excel
                    </h2>
                    <p class="text-xs text-slate-500">Unggah 4 file Excel penjualan 3 bulan dan stok detail terbaru.</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="resetAllData()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition border border-slate-300 flex items-center gap-1">
                        <i class="fa-solid fa-rotate"></i>
                        <span>Reset Data</span>
                    </button>
                </div>
            </div>

            <!-- Upload Boxes Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- File 1: Sales M0 -->
                <div id="dropzoneM0" class="border-2 border-dashed border-slate-300 hover:border-yamaha-blue rounded-xl p-4 text-center transition bg-slate-50 relative group">
                    <input type="file" id="fileM0" accept=".xlsx, .xls" onchange="handleFileSelect('m0', this)" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10">
                    <div class="flex flex-col items-center justify-center space-y-2">
                        <div class="w-10 h-10 rounded-full bg-blue-100 text-yamaha-blue flex items-center justify-center font-bold">
                            <i class="fa-solid fa-calendar-day"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-700">1. Bulan Ini (M0)</span>
                        <p class="text-[11px] text-slate-400">data dari Menu-Sparepart-Penjualan_Cek Laporan Penjualan (Sparepart) INGAT!! TANGGAL DI UBAH</p>
                        <div id="statusM0" class="text-[11px] font-semibold text-slate-500 bg-white px-2 py-1 rounded border border-slate-200 w-full truncate">
                            Belum diunggah
                        </div>
                    </div>
                </div>

                <!-- File 2: Sales M1 -->
                <div id="dropzoneM1" class="border-2 border-dashed border-slate-300 hover:border-yamaha-blue rounded-xl p-4 text-center transition bg-slate-50 relative group">
                    <input type="file" id="fileM1" accept=".xlsx, .xls" onchange="handleFileSelect('m1', this)" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10">
                    <div class="flex flex-col items-center justify-center space-y-2">
                        <div class="w-10 h-10 rounded-full bg-blue-100 text-yamaha-blue flex items-center justify-center font-bold">
                            <i class="fa-solid fa-calendar-minus"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-700">2. Bulan Kemarin (M1)</span>
                        <p class="text-[11px] text-slate-400">data dari Menu-Sparepart-Penjualan_Cek Laporan Penjualan (Sparepart) INGAT!! TANGGAL DI UBAH</p>
                        <div id="statusM1" class="text-[11px] font-semibold text-slate-500 bg-white px-2 py-1 rounded border border-slate-200 w-full truncate">
                            Belum diunggah
                        </div>
                    </div>
                </div>

                <!-- File 3: Sales M2 -->
                <div id="dropzoneM2" class="border-2 border-dashed border-slate-300 hover:border-yamaha-blue rounded-xl p-4 text-center transition bg-slate-50 relative group">
                    <input type="file" id="fileM2" accept=".xlsx, .xls" onchange="handleFileSelect('m2', this)" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10">
                    <div class="flex flex-col items-center justify-center space-y-2">
                        <div class="w-10 h-10 rounded-full bg-blue-100 text-yamaha-blue flex items-center justify-center font-bold">
                            <i class="fa-solid fa-calendar-xmark"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-700">3. Bulan Kemarin Lusa (M2)</span>
                        <p class="text-[11px] text-slate-400">data dari Menu-Sparepart-Penjualan_Cek Laporan Penjualan (Sparepart) INGAT!! TANGGAL DI UBAH</p>
                        <div id="statusM2" class="text-[11px] font-semibold text-slate-500 bg-white px-2 py-1 rounded border border-slate-200 w-full truncate">
                            Belum diunggah
                        </div>
                    </div>
                </div>

                <!-- File 4: Stock Detail -->
                <div id="dropzoneStock" class="border-2 border-dashed border-slate-300 hover:border-yamaha-blue rounded-xl p-4 text-center transition bg-slate-50 relative group">
                    <input type="file" id="fileStock" accept=".xlsx, .xls" onchange="handleFileSelect('stock', this)" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10">
                    <div class="flex flex-col items-center justify-center space-y-2">
                        <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-700">4. Stok Detail</span>
                        <p class="text-[11px] text-slate-400">data dari Menu-Sparepart-Gudang Part-Cek Informasi Stok- Pilih SOCK DETAIL</p>
                        <div id="statusStock" class="text-[11px] font-semibold text-slate-500 bg-white px-2 py-1 rounded border border-slate-200 w-full truncate">
                            Belum diunggah
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Button -->
            <div class="mt-5 flex items-center justify-center">
                <button id="btnProcessData" onclick="processAllFiles()" disabled class="w-full sm:w-auto px-8 py-3 bg-slate-300 text-slate-500 font-bold text-sm rounded-xl transition cursor-not-allowed flex items-center justify-center gap-2 shadow">
                    <i class="fa-solid fa-gears"></i>
                    <span>PROSES DATA REKOMENDASI</span>
                </button>
            </div>
        </section>

        <!-- DASHBOARD SUMMARY SECTION -->
        <section id="dashboardSection" class="hidden space-y-4">
            <!-- Metadata Info Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs bg-slate-800 text-slate-300 px-4 py-2.5 rounded-lg shadow">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span class="font-medium">Status Pengolahan: <strong class="text-emerald-400">Selesai & Valid</strong></span>
                </div>
                <div class="flex items-center gap-4 mt-1 sm:mt-0 text-slate-400">
                    <span><i class="fa-regular fa-clock mr-1"></i> Terakhir Diproses: <strong id="lastProcessTime" class="text-white">-</strong></span>
                    <span><i class="fa-solid fa-list-check mr-1"></i> Total Item: <strong id="totalPartCount" class="text-white">0</strong></span>
                </div>
            </div>

            <!-- Cards Summary Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
                <!-- Card 1 -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col">
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Unique Part Code</span>
                    <span id="statUniqueParts" class="text-2xl font-black text-slate-800 mt-1">0</span>
                    <p class="text-[10px] text-slate-500 mt-auto pt-1">Total spare part terdaftar</p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col">
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Penjualan 3 Bulan</span>
                    <span id="statTotalSales3M" class="text-2xl font-black text-blue-600 mt-1">0</span>
                    <p class="text-[10px] text-slate-500 mt-auto pt-1">Total unit terjual (M0+M1+M2)</p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-col">
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Stok Saat Ini</span>
                    <span id="statTotalStock" class="text-2xl font-black text-slate-700 mt-1">0</span>
                    <p class="text-[10px] text-slate-500 mt-auto pt-1">Akumulasi stok fisik</p>
                </div>

                <!-- Card 4 -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-amber-200 bg-amber-50/30 flex flex-col">
                    <span class="text-[11px] font-bold text-amber-700 uppercase tracking-wider">Part Perlu Order</span>
                    <span id="statPartsToOrder" class="text-2xl font-black text-amber-600 mt-1">0</span>
                    <p class="text-[10px] text-amber-700 mt-auto pt-1">Part dengan Rekomendasi > 0</p>
                </div>

                <!-- Card 5 -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-emerald-200 bg-emerald-50/30 flex flex-col col-span-2 sm:col-span-1">
                    <span class="text-[11px] font-bold text-emerald-700 uppercase tracking-wider">Qty Order Rekomendasi</span>
                    <span id="statTotalQtyRec" class="text-2xl font-black text-emerald-600 mt-1">0</span>
                    <p class="text-[10px] text-emerald-700 mt-auto pt-1">Total unit yang harus diorder</p>
                </div>
            </div>

            <!-- ABC Category Breakdown Bar -->
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Breakdown ABC Category</h3>
                    <span class="text-[11px] text-slate-400">Distribusi Prioritas Kategori Part</span>
                </div>
                <div id="abcBreakdownContainer" class="grid grid-cols-6 gap-2 text-center text-xs">
                    <!-- Dynamic badges populated via JS -->
                </div>
            </div>
        </section>

        <!-- MAIN RECOMMENDATION TABLE SECTION -->
        <section id="tableSection" class="hidden bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden">
            <!-- Table Toolbar -->
            <div class="p-4 bg-slate-50 border-b border-slate-200 space-y-3">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                    <!-- Quick Preset Filters -->
                    <div class="flex items-center flex-wrap gap-1.5">
                        <button onclick="setPresetFilter('ALL')" id="presetALL" class="preset-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-yamaha-blue text-white shadow">
                            SEMUA
                        </button>
                        <button onclick="setPresetFilter('ORDER')" id="presetORDER" class="preset-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-100">
                            <i class="fa-solid fa-cart-shopping text-amber-500 mr-1"></i>PERLU ORDER
                        </button>
                        <button onclick="setPresetFilter('STOCK0')" id="presetSTOCK0" class="preset-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-100">
                            <i class="fa-solid fa-triangle-exclamation text-red-500 mr-1"></i>STOK 0
                        </button>
                        <button onclick="setPresetFilter('SAFE')" id="presetSAFE" class="preset-btn px-3 py-1.5 text-xs font-bold rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-100">
                            <i class="fa-solid fa-shield-check text-emerald-500 mr-1"></i>STOK AMAN
                        </button>
                    </div>

                    <!-- Export Actions -->
                    <div class="flex items-center gap-2">
                        <button onclick="exportToExcel()" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg transition flex items-center gap-1.5 shadow">
                            <i class="fa-solid fa-file-excel"></i>
                            <span>Export Excel</span>
                        </button>
                        <button onclick="exportToCSV()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-800 text-white text-xs font-bold rounded-lg transition flex items-center gap-1.5 shadow">
                            <i class="fa-solid fa-file-csv"></i>
                            <span>Export CSV</span>
                        </button>
                    </div>
                </div>

                <!-- Secondary Filter Bar -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 pt-2 border-t border-slate-200">
                    <!-- Search Input -->
                    <div class="relative md:col-span-2">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        </span>
                        <input type="text" id="searchInput" oninput="handleSearchFilterChange()" class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-yamaha-blue" placeholder="Cari Kode Part atau Nama Part...">
                    </div>

                    <!-- Filter ABC -->
                    <div>
                        <select id="filterABC" onchange="handleSearchFilterChange()" class="w-full py-1.5 px-2 text-xs rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-yamaha-blue">
                            <option value="ALL">Semua ABC Category</option>
                            <option value="A">ABC: A</option>
                            <option value="B">ABC: B</option>
                            <option value="C">ABC: C</option>
                            <option value="D">ABC: D</option>
                            <option value="S">ABC: S</option>
                            <option value="N">ABC: N</option>
                        </select>
                    </div>

                    <!-- Options Toggle -->
                    <div class="flex items-center justify-between gap-2">
                        <button onclick="toggleDetailColumns()" id="btnToggleDetails" class="px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-lg transition flex items-center gap-1 w-full justify-center">
                            <i class="fa-solid fa-eye"></i>
                            <span id="txtToggleDetails">Tampil Detail</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table Container -->
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="bg-slate-800 text-white uppercase tracking-wider text-[11px] sticky top-0 z-10">
                        <tr>
                            <th class="py-3 px-3 border-b border-slate-700">Kode Part</th>
                            <th class="py-3 px-3 border-b border-slate-700">Nama Part</th>
                            <th class="py-3 px-2 border-b border-slate-700 text-center">ABC</th>
                            
                            <!-- Detail Columns (Collapsible) -->
                            <th class="detail-col hidden py-3 px-2 border-b border-slate-700 text-right">M0 (Bln Ini)</th>
                            <th class="detail-col hidden py-3 px-2 border-b border-slate-700 text-right">M1 (Kmrn)</th>
                            <th class="detail-col hidden py-3 px-2 border-b border-slate-700 text-right">M2 (Lusa)</th>
                            <th class="detail-col hidden py-3 px-2 border-b border-slate-700 text-right">Tot 3 Bln</th>
                            
                            <th class="py-3 px-2 border-b border-slate-700 text-right cursor-pointer hover:bg-slate-700" onclick="sortByField('avgDemand')">
                                Avg Demand <i class="fa-solid fa-sort text-[10px] ml-0.5"></i>
                            </th>
                            <th class="py-3 px-2 border-b border-slate-700 text-right cursor-pointer hover:bg-slate-700" onclick="sortByField('stockQty')">
                                Stok Saat Ini <i class="fa-solid fa-sort text-[10px] ml-0.5"></i>
                            </th>
                            <th class="py-3 px-2 border-b border-slate-700 text-center">ROQ</th>
                            
                            <th class="detail-col hidden py-3 px-2 border-b border-slate-700 text-right">Kekurangan</th>
                            
                            <th class="py-3 px-3 border-b border-slate-700 text-right cursor-pointer hover:bg-slate-700" onclick="sortByField('recOrder')">
                                Rekomendasi Beli <i class="fa-solid fa-sort text-[10px] ml-0.5"></i>
                            </th>
                            <th class="py-3 px-3 border-b border-slate-700 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody id="recommendationTableBody" class="divide-y divide-slate-200 font-medium">
                        <!-- Table Rows Rendered Dynamically -->
                    </tbody>
                </table>
            </div>

            <!-- Table Footer & Pagination -->
