        function exportROQConfig() {
            const jsonStr = JSON.stringify(APP_STATE.roqConfig, null, 2);
            const blob = new Blob([jsonStr], { type: 'application/json' });
            const url = URL.createObjectURL(blob);

            const a = document.createElement('a');
            a.href = url;
            a.download = `Yamaha_ROQ_Config_${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);

            showToast('Konfigurasi ROQ berhasil diexport!', 'success');
        }

        function importROQConfig(input) {
            const file = input.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (parsed && typeof parsed.defaultROQ === 'number') {
                        APP_STATE.roqConfig = parsed;
                        saveROQSettingsToStorage();
                        document.getElementById('inputDefaultROQ').value = parsed.defaultROQ;
                        renderCustomROQTable();
                        showToast('Konfigurasi ROQ berhasil di-import!', 'success');

                        if (APP_STATE.processedData.length > 0) {
                            processAllFiles();
                        }
                    } else {
                        throw new Error("Format JSON ROQ tidak valid!");
                    }
                } catch (err) {
                    showToast(`Gagal Import: ${err.message}`, 'error');
                }
            };
            reader.readAsText(file);
        }

