        function openAdminModal() {
            if (!APP_STATE.currentUser || APP_STATE.currentUser.role !== 'admin') {
                showToast('Akses khusus Admin!', 'error');
                return;
            }

            document.getElementById('inputDefaultROQ').value = APP_STATE.roqConfig.defaultROQ || 10;
            renderCustomROQTable();
            document.getElementById('adminModal').classList.remove('hidden');
