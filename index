    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 space-y-2 pointer-events-none"></div>

    <!-- JAVASCRIPT APP ENGINE -->
    <script>
        // APP STATE
        const APP_STATE = {
            currentUser: null, // { username, name, role }
            files: {
                m0: null,
                m1: null,
                m2: null,
                stock: null
            },
            processedData: [],   // Master array of objects
            filteredData: [],    // Filtered array for table
            roqConfig: {
                defaultROQ: 10,
                customROQ: {} // { '90793AJ90900': 20 }
            },
            lastProcessTime: null,
            currentPage: 1,
            itemsPerPage: 25,
            activePreset: 'ALL',
            showDetails: false,
            sortField: 'recOrder',
            sortDirection: 'desc'
        };

        // USER CREDENTIALS
        const USERS = {
            yamaha: { password: '123456', name: 'Bengkel', role: 'bengkel' },
            sulton: { password: 'sulton123', name: 'Admin', role: 'admin' }
        };

        // ON LOAD INITIALIZATION
        window.onload = function() {
            loadROQSettingsFromStorage();
            checkExistingSession();
        };

        // LOCAL STORAGE LOAD / SAVE ROQ
        function loadROQSettingsFromStorage() {
            try {
                const saved = localStorage.getItem('yamaha_roq_config');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (parsed && typeof parsed.defaultROQ === 'number') {
                        APP_STATE.roqConfig = parsed;
                    }
                }
            } catch (e) {
                console.error("Failed to load ROQ settings from LocalStorage", e);
            }
        }

        function saveROQSettingsToStorage() {
            try {
                localStorage.setItem('yamaha_roq_config', JSON.stringify(APP_STATE.roqConfig));
            } catch (e) {
                console.error("Failed to save ROQ settings to LocalStorage", e);
            }
        }

        // LOGIN & LOGOUT
        function checkExistingSession() {
            const savedSession = sessionStorage.getItem('yamaha_user_session');
            if (savedSession) {
                try {
                    const user = JSON.parse(savedSession);
                    setUserSession(user);
                    return;
                } catch(e){}
            }
            showLoginModal(true);
        }

        function handleLogin(event) {
            event.preventDefault();
            const u = document.getElementById('loginUsername').value.trim();
            const p = document.getElementById('loginPassword').value.trim();
            const errDiv = document.getElementById('loginError');

            if (USERS[u] && USERS[u].password === p) {
                const userObj = { username: u, name: USERS[u].name, role: USERS[u].role };
                sessionStorage.setItem('yamaha_user_session', JSON.stringify(userObj));
                setUserSession(userObj);
                errDiv.classList.add('hidden');
                showLoginModal(false);
                showToast(`Selamat datang, ${userObj.name}!`, 'success');
            } else {
                errDiv.classList.remove('hidden');
            }
        }

        function setUserSession(user) {
            APP_STATE.currentUser = user;
            document.getElementById('userNameDisplay').innerText = user.name;
            document.getElementById('userRoleBadge').innerText = user.role.toUpperCase();

            const adminBtn = document.getElementById('btnAdminMenu');
            if (user.role === 'admin') {
                adminBtn.classList.remove('hidden');
            } else {
                adminBtn.classList.add('hidden');
            }
        }

        function handleLogout() {
            sessionStorage.removeItem('yamaha_user_session');
            APP_STATE.currentUser = null;
            showLoginModal(true);
            showToast('Anda telah keluar dari aplikasi.', 'info');
        }

        function showLoginModal(show) {
            const modal = document.getElementById('loginModal');
            if (show) modal.classList.remove('hidden');
            else modal.classList.add('hidden');
        }

        // PART CODE NORMALIZATION (CRITICAL REQUIREMENT)
        function normalizePartCode(val) {
            if (val === null || val === undefined) return "";
            let str = String(val).trim();
            // Remove non-printable, zero-width spaces (\u200B-\u200D, \uFEFF)
            str = str.replace(/[\u200B-\u200D\uFEFF]/g, "");
            // Remove internal spaces if needed, Yamaha codes keep formatting exact
            str = str.replace(/\s+/g, "");
            return str.toUpperCase();
        }

        // FILE UPLOAD HANDLERS
        function handleFileSelect(type, input) {
            const file = input.files[0];
            const statusDiv = document.getElementById(`status${type.toUpperCase()}`);
            
            if (!file) {
                APP_STATE.files[type] = null;
                statusDiv.innerHTML = 'Belum diunggah';
                statusDiv.className = "text-[11px] font-semibold text-slate-500 bg-white px-2 py-1 rounded border border-slate-200 w-full truncate";
                checkProcessButtonState();
                return;
            }

            // Read preview info using SheetJS
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    const jsonData = XLSX.utils.sheet_to_json(firstSheet, { header: 1, raw: true, defval: '' });

                    const rowCount = Math.max(0, jsonData.length - 1);
                    APP_STATE.files[type] = {
                        file: file,
                        workbook: workbook,
                        rowCount: rowCount
                    };

                    statusDiv.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-500 mr-1"></i> ${file.name} (${rowCount} baris)`;
                    statusDiv.className = "text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-1 rounded border border-emerald-300 w-full truncate";

                    showToast(`Berhasil membaca ${file.name}`, 'success');
                } catch (err) {
                    console.error("Error reading excel:", err);
                    APP_STATE.files[type] = null;
                    statusDiv.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-red-500 mr-1"></i> Gagal Membaca File`;
                    statusDiv.className = "text-[11px] font-semibold text-red-700 bg-red-50 px-2 py-1 rounded border border-red-300 w-full truncate";
                    showToast(`File ${file.name} korup atau bukan Excel valid!`, 'error');
                }
                checkProcessButtonState();
            };
            reader.readAsArrayBuffer(file);
        }

        function checkProcessButtonState() {
            const btn = document.getElementById('btnProcessData');
            const allUploaded = APP_STATE.files.m0 && APP_STATE.files.m1 && APP_STATE.files.m2 && APP_STATE.files.stock;
            
            if (allUploaded) {
                btn.disabled = false;
                btn.className = "w-full sm:w-auto px-8 py-3 bg-yamaha-blue hover:bg-yamaha-darkblue text-white font-bold text-sm rounded-xl transition cursor-pointer shadow-lg hover:shadow-xl flex items-center justify-center gap-2 transform hover:-translate-y-0.5";
            } else {
                btn.disabled = true;
                btn.className = "w-full sm:w-auto px-8 py-3 bg-slate-300 text-slate-500 font-bold text-sm rounded-xl transition cursor-not-allowed flex items-center justify-center gap-2 shadow";
            }
        }

        // PARSE SALES EXCEL FILE
        function parseSalesFile(fileObj, fileLabel) {
            const sheet = fileObj.workbook.Sheets[fileObj.workbook.SheetNames[0]];
            const rawData = XLSX.utils.sheet_to_json(sheet, { header: 1, raw: true, defval: '' });

            if (!rawData || rawData.length === 0) {
                throw new Error(`File ${fileLabel} kosong!`);
            }

            // Column Mapping Fallbacks
            // Default Col D = 3 (Order Parts), Col E = 4 (Nama Part), Col H = 7 (ABC), Col L = 11 (Order Qty)
            let colOrderParts = 3;
            let colPartName = 4;
            let colABC = 7;
            let colOrderQty = 11;

            // Header auto-detection scan in first 10 rows
            let headerRowIndex = -1;
            for (let r = 0; r < Math.min(10, rawData.length); r++) {
                const row = rawData[r];
                if (!Array.isArray(row)) continue;
                for (let c = 0; c < row.length; c++) {
                    const cellVal = String(row[c]).toLowerCase().trim();
                    if (cellVal.includes('order parts') || cellVal.includes('part code') || cellVal.includes('kode part')) {
                        colOrderParts = c;
                        headerRowIndex = r;
                    }
                    if (cellVal.includes('nama part') || cellVal.includes('part name') || cellVal.includes('description')) {
                        colPartName = c;
                    }
                    if (cellVal === 'abc' || cellVal.includes('kategori abc') || cellVal.includes('abc cat')) {
                        colABC = c;
                    }
                    if (cellVal.includes('order qty') || cellVal.includes('sales qty') || cellVal.includes('qty')) {
                        colOrderQty = c;
                    }
                }
                if (headerRowIndex !== -1) break;
            }

            const startRow = headerRowIndex !== -1 ? headerRowIndex + 1 : 0;
            const salesMap = new Map(); // partCode -> { qty, name, abc }

            for (let r = startRow; r < rawData.length; r++) {
                const row = rawData[r];
                if (!row || row.length === 0) continue;

                const rawCode = row[colOrderParts];
                const partCode = normalizePartCode(rawCode);

                if (!partCode || partCode === 'ORDERPARTS' || partCode === 'KODEPART') continue;

                const partName = row[colPartName] ? String(row[colPartName]).trim() : '';
                const abc = row[colABC] ? String(row[colABC]).trim().toUpperCase() : '';
                const qtyVal = parseFloat(row[colOrderQty]) || 0;

                if (!salesMap.has(partCode)) {
                    salesMap.set(partCode, { qty: 0, name: partName, abc: abc });
                }

                const existing = salesMap.get(partCode);
                existing.qty += qtyVal;
                if (!existing.name && partName) existing.name = partName;
                if (!existing.abc && abc) existing.abc = abc;
            }

            return salesMap;
        }

        // PARSE STOCK DETAIL EXCEL FILE
        function parseStockFile(fileObj) {
            const sheet = fileObj.workbook.Sheets[fileObj.workbook.SheetNames[0]];
            const rawData = XLSX.utils.sheet_to_json(sheet, { header: 1, raw: true, defval: '' });

            if (!rawData || rawData.length === 0) {
                throw new Error("File Stok Detail kosong!");
            }

            // Col A = 0 (Parts Code), Col C = 2 (Parts Name), Col D = 3 (Superseding), Col H = 7 (Stock Qty), Col N = 13 (ABC Category)
            let colPartsCode = 0;
            let colPartsName = 2;
            let colStockQty = 7;
            let colABC = 13;

            let headerRowIndex = -1;
            for (let r = 0; r < Math.min(10, rawData.length); r++) {
                const row = rawData[r];
                if (!Array.isArray(row)) continue;
                for (let c = 0; c < row.length; c++) {
                    const cellVal = String(row[c]).toLowerCase().trim();
                    if (cellVal.includes('parts code') || cellVal.includes('part code') || cellVal.includes('kode part')) {
                        colPartsCode = c;
                        headerRowIndex = r;
                    }
                    if (cellVal.includes('parts name') || cellVal.includes('part name')) {
                        colPartsName = c;
                    }
                    if (cellVal.includes('stock qty') || cellVal.includes('stok qty') || cellVal.includes('stock')) {
                        colStockQty = c;
                    }
                    if (cellVal.includes('abc category') || cellVal.includes('abc')) {
                        colABC = c;
                    }
                }
                if (headerRowIndex !== -1) break;
            }

            const startRow = headerRowIndex !== -1 ? headerRowIndex + 1 : 0;
            const stockMap = new Map(); // partCode -> { stockQty, name, abc }

            for (let r = startRow; r < rawData.length; r++) {
                const row = rawData[r];
                if (!row || row.length === 0) continue;

                const rawCode = row[colPartsCode];
                const partCode = normalizePartCode(rawCode);

                if (!partCode || partCode === 'PARTSCODE' || partCode === 'KODEPART') continue;

                const partName = row[colPartsName] ? String(row[colPartsName]).trim() : '';
                const stockVal = parseFloat(row[colStockQty]) || 0;
                const abcCat = row[colABC] ? String(row[colABC]).trim().toUpperCase() : '';

                if (!stockMap.has(partCode)) {
                    stockMap.set(partCode, { stockQty: 0, name: partName, abc: abcCat });
                }

                const existing = stockMap.get(partCode);
                existing.stockQty += stockVal; // Aggregate stock across multiple locations
                if (!existing.name && partName) existing.name = partName;
                if (!existing.abc && abcCat) existing.abc = abcCat;
            }

            return stockMap;
        }

        // MASTER PROCESS DATA
        function processAllFiles() {
            try {
                showToast('Sedang memproses 4 file Excel...', 'info');

                // 1. Parse Sales M0, M1, M2
                const mapM0 = parseSalesFile(APP_STATE.files.m0, 'Bulan Ini');
                const mapM1 = parseSalesFile(APP_STATE.files.m1, 'Bulan Kemarin');
                const mapM2 = parseSalesFile(APP_STATE.files.m2, 'Bulan Kemarin Lusa');

                // 2. Parse Stock Detail
                const mapStock = parseStockFile(APP_STATE.files.stock);

                // 3. Collect ALL unique Part Codes across Sales & Stock
                const allPartCodes = new Set([
                    ...mapM0.keys(),
                    ...mapM1.keys(),
                    ...mapM2.keys(),
                    ...mapStock.keys()
                ]);

                const results = [];

                // 4. Calculate for each part code
                allPartCodes.forEach(partCode => {
                    const dataM0 = mapM0.get(partCode) || { qty: 0, name: '', abc: '' };
                    const dataM1 = mapM1.get(partCode) || { qty: 0, name: '', abc: '' };
                    const dataM2 = mapM2.get(partCode) || { qty: 0, name: '', abc: '' };
                    const dataStock = mapStock.get(partCode) || { stockQty: 0, name: '', abc: '' };

                    const m0Qty = dataM0.qty;
                    const m1Qty = dataM1.qty;
                    const m2Qty = dataM2.qty;
                    const totalSales3M = m0Qty + m1Qty + m2Qty;

                    // Exact Average Demand (unrounded)
                    const avgDemand = totalSales3M / 3;

                    const stockQty = dataStock.stockQty;

                    // Part Name Priority: Stock Name > M0 Name > M1 Name > M2 Name > Part Code
                    const partName = dataStock.name || dataM0.name || dataM1.name || dataM2.name || '-';

                    // ABC Category Priority: Stock ABC > Sales ABC > 'N'
                    let abcCategory = dataStock.abc || dataM0.abc || dataM1.abc || dataM2.abc || 'N';
                    if (!['A','B','C','D','S','N'].includes(abcCategory)) {
                        abcCategory = 'N';
                    }

                    // ROQ Priority: Custom ROQ per part -> Default ROQ
                    const roq = (APP_STATE.roqConfig.customROQ && APP_STATE.roqConfig.customROQ[partCode]) 
                        ? APP_STATE.roqConfig.customROQ[partCode] 
                        : (APP_STATE.roqConfig.defaultROQ || 10);

                    // Recommendation Calculation Formulas
                    const targetStock = avgDemand;
                    const kekurangan = targetStock - stockQty;

                    let recOrder = 0;
                    let status = 'STOK AMAN';

                    if (kekurangan <= 0 || stockQty >= avgDemand) {
                        recOrder = 0;
                        status = 'STOK AMAN';
                    } else {
                        // Kekurangan > 0
                        recOrder = Math.ceil(kekurangan / roq) * roq;
                        if (stockQty === 0) {
                            status = 'STOK 0';
                        } else {
                            status = 'REKOMENDASI ORDER';
                        }
                    }

                    results.push({
                        partCode: partCode,
                        partName: partName,
                        m0Qty: m0Qty,
                        m1Qty: m1Qty,
                        m2Qty: m2Qty,
                        totalSales3M: totalSales3M,
                        avgDemand: avgDemand,
                        stockQty: stockQty,
                        abcCategory: abcCategory,
                        roq: roq,
                        kekurangan: kekurangan,
                        recOrder: recOrder,
                        status: status
                    });
                });

                APP_STATE.processedData = results;
                APP_STATE.lastProcessTime = new Date().toLocaleString('id-ID');

                // Update UI Components
                renderDashboard();
                applyFiltersAndSort();

                document.getElementById('dashboardSection').classList.remove('hidden');
                document.getElementById('tableSection').classList.remove('hidden');

                showToast(`Sukses memproses ${results.length} kode spare part!`, 'success');

            } catch (err) {
                console.error("Failed processing data:", err);
                showToast(`Gagal Memproses: ${err.message}`, 'error');
            }
        }

        // RENDER DASHBOARD STATS
        function renderDashboard() {
            const data = APP_STATE.processedData;
            const uniqueParts = data.length;
            const totalSales = data.reduce((sum, item) => sum + item.totalSales3M, 0);
            const totalStock = data.reduce((sum, item) => sum + item.stockQty, 0);
            const partsToOrder = data.filter(item => item.recOrder > 0).length;
            const totalQtyRec = data.reduce((sum, item) => sum + item.recOrder, 0);

            document.getElementById('lastProcessTime').innerText = APP_STATE.lastProcessTime || '-';
            document.getElementById('totalPartCount').innerText = uniqueParts.toLocaleString('id-ID');

            document.getElementById('statUniqueParts').innerText = uniqueParts.toLocaleString('id-ID');
            document.getElementById('statTotalSales3M').innerText = totalSales.toLocaleString('id-ID');
            document.getElementById('statTotalStock').innerText = totalStock.toLocaleString('id-ID');
            document.getElementById('statPartsToOrder').innerText = partsToOrder.toLocaleString('id-ID');
            document.getElementById('statTotalQtyRec').innerText = totalQtyRec.toLocaleString('id-ID');

            // ABC Breakdown calculation
            const abcCounts = { A: 0, B: 0, C: 0, D: 0, S: 0, N: 0 };
            data.forEach(item => {
                if (abcCounts.hasOwnProperty(item.abcCategory)) {
                    abcCounts[item.abcCategory]++;
                } else {
                    abcCounts['N']++;
                }
            });

            const container = document.getElementById('abcBreakdownContainer');
            container.innerHTML = Object.keys(abcCounts).map(cat => {
                const count = abcCounts[cat];
                const pct = uniqueParts > 0 ? Math.round((count / uniqueParts) * 100) : 0;
                return `
                    <div class="bg-slate-50 border border-slate-200 p-2 rounded-lg">
                        <span class="font-extrabold text-slate-800 text-sm">Kat. ${cat}</span>
