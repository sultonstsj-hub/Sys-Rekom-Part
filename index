        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
        }

        function saveDefaultROQ() {
            const val = parseInt(document.getElementById('inputDefaultROQ').value, 10);
            if (isNaN(val) || val <= 0) {
                showToast('Nilai ROQ Default harus berupa angka positif > 0!', 'error');
                return;
            }

            APP_STATE.roqConfig.defaultROQ = val;
            saveROQSettingsToStorage();
            showToast(`ROQ Default berhasil diubah menjadi ${val}`, 'success');

            // Re-calculate if data exists
            if (APP_STATE.processedData.length > 0) {
                processAllFiles();
            }
        }

        function addCustomROQ() {
            const codeInput = document.getElementById('adminNewPartCode');
            const roqInput = document.getElementById('adminNewROQ');

            const code = normalizePartCode(codeInput.value);
            const val = parseInt(roqInput.value, 10);

            if (!code) {
                showToast('Masukkan Kode Part yang valid!', 'warning');
                return;
            }
            if (isNaN(val) || val <= 0) {
                showToast('Nilai ROQ harus angka positif > 0!', 'warning');
                return;
            }

            if (!APP_STATE.roqConfig.customROQ) APP_STATE.roqConfig.customROQ = {};
            APP_STATE.roqConfig.customROQ[code] = val;

            saveROQSettingsToStorage();
            renderCustomROQTable();

            codeInput.value = '';
            roqInput.value = '';

            showToast(`ROQ Khusus part ${code} di-set ke ${val}`, 'success');

            if (APP_STATE.processedData.length > 0) {
                processAllFiles();
            }
        }

        function removeCustomROQ(code) {
            if (APP_STATE.roqConfig.customROQ && APP_STATE.roqConfig.customROQ[code]) {
                delete APP_STATE.roqConfig.customROQ[code];
                saveROQSettingsToStorage();
                renderCustomROQTable();
                showToast(`ROQ Khusus untuk ${code} telah dihapus.`, 'info');

                if (APP_STATE.processedData.length > 0) {
                    processAllFiles();
                }
            }
        }

        function renderCustomROQTable() {
            const tbody = document.getElementById('customROQTableBody');
            tbody.innerHTML = '';

            const customMap = APP_STATE.roqConfig.customROQ || {};
            const keys = Object.keys(customMap);

            if (keys.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="3" class="p-3 text-center text-slate-400 italic">
                            Belum ada pengaturan ROQ khusus per kode part.
                        </td>
                    </tr>
                `;
                return;
            }

            keys.forEach(code => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-2 font-mono font-bold text-slate-800">${code}</td>
                    <td class="p-2 font-bold text-amber-700">${customMap[code]}</td>
                    <td class="p-2 text-center">
                        <button onclick="removeCustomROQ('${code}')" class="px-2 py-0.5 bg-red-100 hover:bg-red-200 text-red-700 rounded text-[10px] font-bold">
                            Hapus
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
