        // TOAST NOTIFICATIONS
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');

            let bgClass = "bg-slate-800 text-white";
            let iconClass = "fa-info-circle text-blue-400";

            if (type === 'success') {
                bgClass = "bg-emerald-800 text-white";
                iconClass = "fa-circle-check text-emerald-300";
            } else if (type === 'error') {
                bgClass = "bg-red-800 text-white";
                iconClass = "fa-triangle-exclamation text-red-300";
            } else if (type === 'warning') {
                bgClass = "bg-amber-800 text-white";
                iconClass = "fa-triangle-exclamation text-amber-300";
            }

            toast.className = `flex items-center gap-2.5 px-4 py-3 rounded-xl shadow-2xl border border-white/10 text-xs font-semibold ${bgClass} transform transition duration-300 pointer-events-auto`;
            toast.innerHTML = `<i class="fa-solid ${iconClass} text-base"></i> <span>${message}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => {
                    if (toast.parentNode) toast.parentNode.removeChild(toast);
                }, 300);
            }, 3500);
        }
    </script>
</body>
</html>
